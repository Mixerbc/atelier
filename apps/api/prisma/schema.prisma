generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  DISABLED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  MOBILE
  OTHER
}

enum InventoryReason {
  SALE
  RESTOCK
  ADJUSTMENT
  CANCEL_RESTORE
  MANUAL
  INITIAL
}

model AdminUser {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String
  passwordHash String
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  movements    InventoryMovement[]
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Attribute {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  values    AttributeValue[]
  products  ProductAttribute[]
}

model AttributeValue {
  id           String                  @id @default(cuid())
  attributeId  String
  name         String
  slug         String
  abbreviation String?
  hexCode      String?
  imageUrl     String?
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants     VariantAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId])
}

model Product {
  id               String              @id @default(cuid())
  categoryId       String
  name             String
  slug             String              @unique
  shortDescription String              @default("")
  description      String              @default("")
  basePriceCents   Int
  salePriceCents   Int?
  costCents        Int?
  sku              String?
  brand            String?
  status           ProductStatus       @default(DRAFT)
  isFeatured       Boolean             @default(false)
  isNew            Boolean             @default(false)
  hasVariants      Boolean             @default(false)
  trackInventory   Boolean             @default(true)
  stock            Int                 @default(0)
  minStock         Int                 @default(0)
  sortOrder        Int                 @default(0)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         Category            @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  extras           ProductExtra[]
  attributes       ProductAttribute[]
  orderItems       OrderItem[]
  movements        InventoryMovement[]

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
}

model ProductAttribute {
  id          String    @id @default(cuid())
  productId   String
  attributeId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String   @default("")
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductExtra {
  id         String  @id @default(cuid())
  productId  String
  name       String
  priceCents Int
  isActive   Boolean @default(true)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  sku             String                  @unique
  priceCents      Int?
  priceDeltaCents Int                     @default(0)
  stock           Int                     @default(0)
  minStock        Int                     @default(0)
  weightGrams     Int?
  imageUrl        String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes      VariantAttributeValue[]
  orderItems      OrderItem[]
  movements       InventoryMovement[]

  @@index([productId])
}

model VariantAttributeValue {
  id               String         @id @default(cuid())
  variantId        String
  attributeValueId String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([phone])
}

model Order {
  id              String               @id @default(cuid())
  folio           String               @unique
  customerId      String
  status          OrderStatus          @default(NEW)
  deliveryType    DeliveryType
  address         String?
  zone            String?
  references      String?
  mapsUrl         String?
  paymentMethod   PaymentMethod
  cashAmountCents Int?
  changeCents     Int?
  paymentNote     String               @default("")
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  notes           String               @default("")
  stockRestored   Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  customer        Customer             @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  movements       InventoryMovement[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                 String          @id @default(cuid())
  orderId            String
  productId          String?
  variantId          String?
  productName        String
  variantLabel       String          @default("")
  sku                String?
  colorName          String?
  sizeName           String?
  imageUrl           String?
  unitPriceCents     Int
  quantity           Int
  lineTotalCents     Int
  notes              String          @default("")
  extrasJson         Json            @default("[]")
  attributesSnapshot Json            @default("[]")
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model InventoryMovement {
  id            String           @id @default(cuid())
  productId     String
  variantId     String?
  orderId       String?
  adminUserId   String?
  previousStock Int
  delta         Int
  finalStock    Int
  reason        InventoryReason
  note          String           @default("")
  createdAt     DateTime         @default(now())
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUser     AdminUser?       @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model BusinessSettings {
  id                   String   @id @default("default")
  storeName            String
  tagline              String   @default("")
  logoUrl              String?
  whatsappNumber       String
  address              String   @default("")
  phone                String   @default("")
  email                String   @default("")
  currency             String   @default("Bs")
  deliveryFeeCents     Int      @default(8000)
  minimumOrderCents    Int      @default(35000)
  hoursJson            Json     @default("[]")
  deliveryZonesJson    Json     @default("[]")
  paymentMethodsJson   Json     @default("[]")
  socialJson           Json     @default("[]")
  ticketFooter         String   @default("")
  cardPaymentAvailable Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}
